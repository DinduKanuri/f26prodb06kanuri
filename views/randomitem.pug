extends layout

block content
  h1= title
  -
    let image_names = [
      "yellowstone.jpg",
      "yosemite.jpg",
      "grandcanyon.jpg",
      "zion.jpg",
      "arches.jpg"
    ];
  
  
  - for (let i = 0; i < 3; i++) {
    - let randomIndex = Math.floor(Math.random() * 5);
    - let imageName = image_names[randomIndex];
    img(src=`/images/${imageName}`, alt=`Park image ${imageName}`, width="300", height="300")
  - }

