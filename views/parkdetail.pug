extends layout

block content
  h1= title

  if toShow
    div.park-detail-card
      h2= toShow.park_name

      div.park-detail-row
        div.park-detail-label Park ID:
        div.park-detail-value= toShow._id

      div.park-detail-row
        div.park-detail-label Park Name:
        div.park-detail-value= toShow.park_name

      div.park-detail-row
        div.park-detail-label State:
        div.park-detail-value= toShow.state

      div.park-detail-row
        div.park-detail-label Area (Acres):
        div.park-detail-value= toShow.area_acres

      a.park-detail-button(href='/parks') Back to Parks

  else
    h2 Park not found
    a(href='/parks') Back to Parks
