extends layout

block content
  h1= title

  div.container-fluid
    div.row
      each park in results
        div.col-sm-3.m-2
          h5 #{park.park_name}
          p State: #{park.state}
          p Area: #{park.area_acres} acres

          - let destination = `dispatch("/parks/update?id=${park._id}")`
          button.btn.btn-primary.ml-1(type="button", onclick=destination) Update

  script.
    function dispatch(path) {
      window.location.href = path;
    }
