extends layout

block content
  h1= title
  
  
  div.container-fluid
    div.row
      each park, index in results
        div.col-sm-2(onclick=`buy(${index})`)
          h5 #{park.park_name}
          p State: #{park.state}
          p Area: #{park.area_acres} acres
        
  
  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }


